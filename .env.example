# ============================================================
# GOBY — Variables de entorno
# Copia este archivo como .env.local y rellena los valores.
# NUNCA subas .env.local a git.
# ============================================================

# ── Supabase ──────────────────────────────────────────────────
# Encuéntralos en: Supabase Dashboard → Settings → API
# Sección "Project URL" + "Project API keys" (anon/public)
VITE_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...TU_ANON_KEY

# ── Modo demo / staging ───────────────────────────────────────
# true  → muestra "Proyecto Demo" en el selector y carga datos simulados
# false → modo producción real
#         Omitir esta variable equivale a false
VITE_DEMO_ENABLED=false

# ── Claude API ────────────────────────────────────────────────
# ⚠ La API key de Claude NO va aquí — va en Supabase Edge Function Secrets.
# Ver: Supabase Dashboard → Edge Functions → Secrets → ANTHROPIC_API_KEY
# Añadir VITE_CLAUDE_API_KEY aquí expondría la clave en el bundle del cliente.
