# ============================================================
# GOBY — Variables de entorno
# Copia este archivo como .env.local y rellena los valores.
# NUNCA subas .env.local a git.
# ============================================================
 
# ── Supabase ──────────────────────────────────────────────────
# Encuéntralos en: Supabase Dashboard → Settings → API
# Sección "Project URL" + "Project API keys" (anon/public)
VITE_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...TU_ANON_KEY
 
# ── Modo demo / staging ───────────────────────────────────────
# true  → muestra "Proyecto Demo" en el selector y carga datos simulados
# false → modo producción real
#         Omitir esta variable equivale a false
VITE_DEMO_ENABLED=false
 
# ── Navegación por paquetes (FDR-002, Fase 1) ─────────────────
# true  → sidebar muestra los 4 paquetes comerciales + Dashboard Global;
#         rutas /packages/* activas. Sin lista plana T1–T12.
# false → comportamiento actual intacto; rutas /packages/* no accesibles.
#         Omitir esta variable equivale a false.
VITE_PACKAGE_NAV_ENABLED=false
 
# ── Entorno de la aplicación ──────────────────────────────────
# Valor en Vercel PRE:  pre
# Valor en Vercel PRO:  production
# Omitir en .env.local (se usará 'development' por defecto)
VITE_APP_ENV=development
 
# ── Sentry — Monitorización de errores ───────────────────────
# Obtén el DSN en: sentry.io → Settings → Projects → Client Keys
# Un solo proyecto Sentry; los errores se etiquetan con VITE_APP_ENV.
# En local, deja VITE_SENTRY_ENABLED=false para no contaminar Sentry.
VITE_SENTRY_DSN=https://TU_DSN@oTU_ORG.ingest.sentry.io/TU_PROJECT_ID
VITE_SENTRY_ENABLED=false
 
# ── Sentry sourcemaps (solo en Vercel PRO, sin VITE_ prefix) ──
# Añade estas variables en Vercel Dashboard → Settings → Environment Variables
# (entorno "Production" únicamente). No van en .env.local.
# SENTRY_AUTH_TOKEN=sntrys_TU_AUTH_TOKEN
# SENTRY_ORG=tu-organizacion
# SENTRY_PROJECT=goby
 
# ── Claude API ────────────────────────────────────────────────
# ⚠ La API key de Claude NO va aquí — va en Supabase Edge Function Secrets.
# Ver: Supabase Dashboard → Edge Functions → Secrets → ANTHROPIC_API_KEY
# Añadir VITE_CLAUDE_API_KEY aquí expondría la clave en el bundle del cliente.
 

